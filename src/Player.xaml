<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="浮光 · Apple Music" Width="390" Height="238" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" FontFamily="Microsoft YaHei UI" Foreground="#F4F4F8">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D4D5DF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="22"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#FD6284" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="10" Height="10"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFF5F8"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#35FFFFFF" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" Margin="6" CornerRadius="20" BorderBrush="#38FFFFFF" BorderThickness="1" Background="#E61A1B26">
  <Grid Margin="18,10,18,13">
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="90"/><RowDefinition Height="34"/><RowDefinition Height="30"/><RowDefinition Height="38"/><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DragBar" Background="Transparent" ToolTip="拖动移动窗口">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#FF698A" Margin="0,0,8,0"/><TextBlock Text="浮光" FontSize="11" Foreground="#C5C4CF"/><TextBlock x:Name="Connection" Text="  /  等待 Apple Music" FontSize="10" Foreground="#9695A8" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LyricsButton" Content="词" FontFamily="Microsoft YaHei UI" FontSize="12" ToolTip="显示 / 隐藏歌词" AutomationProperties.Name="显示隐藏歌词" Foreground="#FF7394"/><Button x:Name="PinButton" Content="&#xE718;" ToolTip="置顶：已开启" AutomationProperties.Name="切换置顶" Foreground="#FF7394"/><Button x:Name="SettingsButton" Content="&#xE713;" ToolTip="外观设置" AutomationProperties.Name="外观设置"/><Button x:Name="CloseButton" Content="&#xE711;" ToolTip="关闭悬浮窗（音乐继续播放）" AutomationProperties.Name="关闭悬浮窗"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,9,0,7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="12" Background="#303240"><Grid><TextBlock Text="♫" FontSize="32" Foreground="#FF7594" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Artwork" CornerRadius="12"/></Grid></Border>
    <StackPanel Grid.Column="1" Margin="15,3,0,0" VerticalAlignment="Center"><TextBlock x:Name="Song" Text="让音乐浮在身边" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Artist" Text="打开 Apple Music，播放一首歌曲" FontSize="11" Foreground="#C0BDCC" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Album" Text="背景可以透明，音乐依然清晰" FontSize="10" Foreground="#8C8B9F" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   </Grid>
   <Grid Grid.Row="2"><TextBlock x:Name="Elapsed" Text="--:--" FontSize="10" Foreground="#ABABBA" VerticalAlignment="Center"/><Slider x:Name="Progress" Margin="40,0,40,0" IsEnabled="False" AutomationProperties.Name="播放进度"/><TextBlock x:Name="Duration" Text="--:--" FontSize="10" Foreground="#ABABBA" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="3"><TextBlock x:Name="Status" Text="等待连接" Foreground="#9392A6" FontSize="10" VerticalAlignment="Center" MaxWidth="102" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="Previous" Content="&#xE892;" ToolTip="上一首" AutomationProperties.Name="上一首" Margin="0,0,13,0" IsEnabled="False"/><Button x:Name="Play" Content="&#xE768;" Background="#FF557C" Foreground="White" ToolTip="播放 / 暂停（空格）" AutomationProperties.Name="播放暂停" Width="44" IsEnabled="False"/><Button x:Name="Next" Content="&#xE893;" ToolTip="下一首" AutomationProperties.Name="下一首" Margin="13,0,0,0" IsEnabled="False"/></StackPanel>
    <TextBlock Text="APPLE MUSIC" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#77778E" FontSize="8"/>
   </Grid>
   <Grid Grid.Row="4" Margin="0,9,0,0"><Button x:Name="MuteButton" Content="&#xE767;" HorizontalAlignment="Left" Width="26" Height="24" ToolTip="Apple Music 应用音量" AutomationProperties.Name="Apple Music静音开关" IsEnabled="False"/><Slider x:Name="VolumeSlider" Margin="34,0,44,0" Minimum="0" Maximum="100" IsEnabled="False" ToolTip="仅调整 Apple Music 的 Windows 应用音量" AutomationProperties.Name="Apple Music音量"/><TextBlock x:Name="VolumeLabel" Text="--" FontSize="10" Foreground="#AAA5BB" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"><Button x:Name="FavoriteCurrent" Content="☆ 喜爱" FontFamily="Microsoft YaHei UI" FontSize="11" Width="94" AutomationProperties.Name="喜爱当前歌曲" IsEnabled="False"/><Button x:Name="DislikeCurrent" Content="减少推荐" FontFamily="Microsoft YaHei UI" FontSize="11" Width="98" ToolTip="向 Apple Music 提交减少推荐当前歌曲" AutomationProperties.Name="减少推荐当前歌曲" IsEnabled="False"/><Button x:Name="BrowseQueue" Content="待播列表" FontFamily="Microsoft YaHei UI" FontSize="11" Width="80" ToolTip="查看接下来播放的歌曲" AutomationProperties.Name="查看待播列表"/></StackPanel>
   <Grid x:Name="LyricsPanel" Grid.Row="6" Height="198" Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Border Background="#25FFFFFF"/>
    <Grid Grid.Row="1"><TextBlock x:Name="LyricSource" Text="同步歌词" FontSize="10" Foreground="#A8A4B8" VerticalAlignment="Center" MaxWidth="185" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ChooseLyrics" Content="搜" FontFamily="Microsoft YaHei UI" FontSize="11" Width="25" ToolTip="搜索并选择歌词版本" AutomationProperties.Name="搜索选择歌词版本"/><Button x:Name="LyricScript" Content="简" FontFamily="Microsoft YaHei UI" FontSize="11" Width="25" Foreground="#FF7394" AutomationProperties.Name="切换歌词简体或原文"/><Button x:Name="ImportLyrics" Content="&#xE8E5;" ToolTip="为当前歌曲导入 LRC / TXT 歌词" AutomationProperties.Name="导入本地歌词" Width="25"/><Button x:Name="RefreshLyrics" Content="&#xE72C;" ToolTip="重新查找联网歌词" AutomationProperties.Name="重新查找歌词" Width="25"/></StackPanel></Grid>
    <Grid Grid.Row="2"><StackPanel x:Name="SyncedLines" VerticalAlignment="Center"><TextBlock x:Name="LyricBefore" Foreground="#9491A7" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" Margin="0,0,0,10"/><TextBlock x:Name="LyricCurrent" Text="播放歌曲后自动查找歌词" Foreground="#FF87A4" FontWeight="SemiBold" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="70"/><TextBlock x:Name="LyricAfter" Foreground="#9491A7" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" Margin="0,10,0,0"/></StackPanel><ScrollViewer x:Name="PlainLyricsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PlainLyricsText" Foreground="#D2CCDF" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="5"/></ScrollViewer></Grid>
    <Grid Grid.Row="3"><TextBlock Text="歌词校时" FontSize="9" Foreground="#858196" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LyricsEarlier" Content="−" FontFamily="Segoe UI" Width="24" Height="22" ToolTip="歌词提前 0.5 秒" AutomationProperties.Name="歌词提前半秒"/><TextBlock x:Name="LyricOffset" Text="0.0s" Width="42" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" Foreground="#A9A2BA"/><Button x:Name="LyricsLater" Content="+" FontFamily="Segoe UI" Width="24" Height="22" ToolTip="歌词延后 0.5 秒" AutomationProperties.Name="歌词延后半秒"/></StackPanel></Grid>
   </Grid>
   <StackPanel x:Name="SettingsPanel" Grid.Row="7" Margin="0,16,0,0" Visibility="Collapsed">
    <Border Height="1" Background="#25FFFFFF" Margin="0,0,0,12"/>
    <Grid><TextBlock Text="背景不透明度" FontSize="11" Foreground="#C6C4D2"/><TextBlock x:Name="OpacityValue" Text="90%" HorizontalAlignment="Right" FontSize="11" Foreground="#FF82A0"/></Grid>
    <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="90" Margin="0,6,0,2" AutomationProperties.Name="背景不透明度"/>
    <TextBlock Text="只改变背景 · 文字和封面保持清晰" FontSize="10" Foreground="#9392A6"/>
    <CheckBox x:Name="AutoLyrics" Content="自动联网查歌词（LRCLIB）" IsChecked="True" Foreground="#C6C4D2" FontSize="11" Margin="0,12,0,0" ToolTip="向 lrclib.net 发送歌名、歌手和时长；可随时关闭"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>

